{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Граф цивилизационных возможностей SINERGY",
  "type": "object",
  "required": [
    "schema_version",
    "counts",
    "nodes",
    "edges"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "canonical_freeze": {
      "type": "string"
    },
    "counts": {
      "type": "object"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(M|T|F|P|I|S)[0-9]{3,}$"
          },
          "type": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "metadata": {
            "type": "object"
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "source",
          "target",
          "type"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^E[0-9]{5,}$"
          },
          "source": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        }
      }
    }
  },
  "description": "Машинная схема графа SINERGY. Технические поля и enum-коды остаются стабильными; человекочитаемые подписи и документация ведутся на русском языке."
}
